{
  "contract": "pmf v1, dir v1, raw v1, book.local.v1",
  "rule": {
    "pmf1": "BLAKE3 derive_key(\"omnileaf.app pmf v1\") over the image count as a little-endian u32, then the (crc32, size) pairs sorted ascending, each a little-endian u32 then a little-endian u64; an archive with no images takes raw1 instead",
    "dir1": "BLAKE3 derive_key(\"omnileaf.app dir v1\") over the image count as a little-endian u32, then for each image, sorted by the bytes of norm(file name) and then by size and the file name's own bytes, its normalised name as a little-endian u32 length and the bytes followed by its size as a little-endian u64, then [0, min(64 KiB, size)) of the first image and [size - min(64 KiB, size), size) of the last",
    "raw1": "BLAKE3 derive_key(\"omnileaf.app raw v1\") over the file size as a little-endian u64, then ten ranges in order: [0, min(64 KiB, size)), [size - min(64 KiB, size), size), and for i in 1..=8 [floor(size * i / 9), min(floor(size * i / 9) + 16 KiB, size)); ranges are clamped to the file and may overlap or repeat",
    "book.local.v1": "the entity-id derivation over the 32-byte fingerprint as the only part"
  },
  "sample_content": "byte i of each raw file and of each folder image is i mod 251",
