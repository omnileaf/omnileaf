{
  "app_name": "Omnileaf",
  "library_title": "Library",
  "library_empty": "Your library is empty.",
  "app_version": "Version {version}",
  "library_add_folder": "Add a folder",
  "library_folder_found": [
    {
      "declarations": [
        "input count",
        "input name",
        "local countPlural = count: plural",
        "local formattedCount = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Found {formattedCount} comic in {name}.",
        "countPlural=other": "Found {formattedCount} comics in {name}."
      }
    }
  ],
  "library_folder_unreadable_subfolders": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local formattedCount = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Couldn't read {formattedCount} folder inside it.",
        "countPlural=other": "Couldn't read {formattedCount} folders inside it."
      }
    }
  ],
  "library_folder_unreadable": "Couldn't read that folder.",
  "library_folder_picker_unavailable": "Adding folders isn't available on this device yet.",
  "library_add_folder_failed": "Something went wrong while adding the folder. Try again."
}
