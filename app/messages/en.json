{
  "app_name": "Omnileaf",
  "library_title": "Library",
  "library_empty": "Your library is empty.",
  "app_version": "Version {version}",
  "library_add_folder": "Add a folder",
  "library_scan_progress": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local formattedCount = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "Finding books · {formattedCount} so far"
      }
    }
  ],
  "library_folder_scanned": [
    {
      "declarations": [
        "input books",
        "input series",
        "input name",
        "local booksPlural = books: plural",
        "local formattedBooks = books: number",
        "local formattedSeries = series: number"
      ],
      "selectors": ["booksPlural"],
      "match": {
        "booksPlural=one": "Found {formattedBooks} book in {formattedSeries} series in {name}.",
        "booksPlural=other": "Found {formattedBooks} books in {formattedSeries} series in {name}."
      }
    }
  ],
  "library_folder_no_books": "Found no books in {name}.",
  "library_folder_unreadable_books": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local formattedCount = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Couldn't read {formattedCount} book in it.",
        "countPlural=other": "Couldn't read {formattedCount} books in it."
      }
    }
  ],
  "library_folder_unreadable_subfolders": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local formattedCount = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Couldn't read {formattedCount} folder inside it.",
        "countPlural=other": "Couldn't read {formattedCount} folders inside it."
      }
    }
  ],
  "library_folder_unreadable": "Couldn't read that folder.",
  "library_folder_picker_unavailable": "Adding folders isn't available on this device yet.",
  "library_add_folder_failed": "Something went wrong while adding the folder. Try again.",
  "navigation_label": "Main",
  "browse_title": "Browse",
