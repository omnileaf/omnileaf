{
  "name": "@omnileaf/app",
  "private": true,
  "type": "module",
  "imports": {
    "#branding/*": "@omnileaf/branding/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules --strategy custom-chosen preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check . && node scripts/check-starting-style.ts",
    "format": "prettier --write .",
    "test": "vitest run --project components --project harness",
    "test:e2e": "playwright test",
    "test:admin": "playwright test -c playwright.admin.config.ts",
    "test:e2e:timings": "node tests/write-browser-timings.ts",
    "test:app": "tauri build --debug --no-bundle --features e2e && vitest run --project app",
    "test:android": "vitest run --project android",
    "test:android:slow": "vitest run --project android-slow",
    "test:ios": "tauri ios build --debug --target aarch64-sim --no-sign && vitest run --project ios",
    "tauri": "tauri",
    "tokens": "node scripts/write-platform-tokens.ts",
    "icons": "node scripts/write-icons.ts",
    "locales-config": "node scripts/write-locales-config.ts",
    "pseudo-locale": "node scripts/write-pseudo-locale.ts && prettier --write messages/en-XA.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@omnileaf/branding": "workspace:*",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.76.0",
    "bits-ui": "2.21.0",
    "cn": "0.5.2",
    "runed": "0.38.0",
    "svelte-sonner": "1.2.3"
  }
}
