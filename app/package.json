{
  "name": "@omnileaf/app",
  "private": true,
  "type": "module",
  "imports": {
    "#branding/*": "@omnileaf/branding/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-chosen preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project components --project harness",
    "test:e2e": "playwright test",
    "test:app": "tauri build --debug --no-bundle --features e2e && vitest run --project app",
    "test:android": "vitest run --project android",
    "test:android:slow": "vitest run --project android-slow",
    "test:ios": "tauri ios build --debug --target aarch64-sim --no-sign && vitest run --project ios",
    "tauri": "tauri",
    "pseudo-locale": "node scripts/write-pseudo-locale.ts && prettier --write messages/en-XA.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.26.0",
    "@inlang/plugin-message-format": "4.4.5",
    "@omnileaf/branding": "workspace:*",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.53.0",
    "bits-ui": "2.19.5",
    "cn": "0.4.0",
    "runed": "0.37.1",
    "svelte-sonner": "1.2.1"
  }
}
